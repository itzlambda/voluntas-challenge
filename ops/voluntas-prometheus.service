[Unit]
Description=Voluntas Prometheus
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=voluntas-prometheus
ExecStart=/opt/voluntas-prometheus/prometheus --config.file=/etc/voluntas/prometheus.yml --storage.tsdb.path=/var/lib/voluntas-prometheus --storage.tsdb.retention.time=7d --storage.tsdb.retention.size=2GB --web.listen-address=127.0.0.1:9091 --query.max-concurrency=4 --query.timeout=5s
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
MemoryMax=768M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
